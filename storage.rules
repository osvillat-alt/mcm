rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMCMAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['osvillat@gmail.com', 'calderamoralesmarisol@gmail.com'];
    }
    function optimizedPhoto() {
      return request.resource.size > 0 && request.resource.size <= 500 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    match /productos/{file} {
      allow read: if true;
      allow create, update: if isMCMAdmin() && optimizedPhoto() && file.matches('^[A-Za-z0-9_-]+[.]jpg$');
      allow delete: if isMCMAdmin();
    }
    match /galeria/{file} {
      allow read: if true;
      allow create, update: if isMCMAdmin() && optimizedPhoto() && file.matches('^[A-Za-z0-9_-]+[.]jpg$');
      allow delete: if isMCMAdmin();
    }
    // Existing customer reference uploads keep their current permissions.
    match /referencias/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
