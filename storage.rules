rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMCMAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['osvillat@gmail.com', 'calderamoralesmarisol@gmail.com'];
    }
    function optimizedPhoto() {
      return request.resource.size > 0 && request.resource.size <= 500 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    match /productos/{file} {
      allow read: if true;
      // Keep existing catalog clients working; the updated admin optimizes new photos to 500 KB.
      allow create, update: if isMCMAdmin() && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isMCMAdmin();
    }
    match /galeria/{file} {
      allow read: if true;
      allow create, update: if isMCMAdmin() && optimizedPhoto() && file.matches('^[A-Za-z0-9_-]+[.]jpg$');
      allow delete: if isMCMAdmin();
    }
    // References are shared by link, not a public directory. App Check/rate limits are still needed.
    match /referencias/{file} {
      allow get: if true;
      allow list: if isMCMAdmin();
      allow create: if resource == null && file.matches('^[a-f0-9-]{36}[.](jpg|png|webp)$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if isMCMAdmin();
    }
  }
}
